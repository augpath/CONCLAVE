# Backend image with R + FlowSOM + DepecheR pre-installed, so 'depeche' and
# 'flowsom' work as clustering methods out of the box.
#
# This is a SEPARATE image from the default backend (see ../README.md,
# "Running it") -- most people should use the default (fast, no R). Only
# build this one if you specifically need flowsom/depeche.
#
# Build (uses a different tag, conclave-backend-r, than the default image's
# conclave-backend, so building this one never overwrites the fast build):
#
#   docker build --build-arg CACHEBUST=$(date +%s) -f backend/Dockerfile.with-r -t conclave-backend-r ./backend
#
# NOT built or tested against a real Docker daemon or the actual CRAN/
# Bioconductor package servers -- neither was reachable from the
# environment this was written in. Written to standard Bioconductor
# installation practice and refined across real build attempts (see the
# system library comments below for what each round of failures needed),
# but still not confirmed to build cleanly end to end. If it fails, the
# `docker build` output will show which system library or R package
# failed to compile -- report it back and it can be fixed here.

FROM python:3.11-slim

WORKDIR /app

# git: requirements.txt installs conclave via git+https
# r-base, r-base-dev: R itself, plus headers needed to compile packages
# libuv1-dev, zlib1g-dev, libbz2-dev, liblzma-dev, libicu-dev,
#   libpcre2-dev, libdeflate-dev: needed by the 'fs' package and other
#   common compression/text-encoding dependencies across the Bioconductor
#   ecosystem (found via a real build failure: 'fs' needs libuv1-dev)
# libgl1-mesa-dev, libglu1-mesa-dev, libx11-dev, libxext-dev, libxt-dev:
#   needed by 'rgl' (3D graphics), a dependency of 'mixOmics', a
#   dependency of DepecheR (found via a real build failure: without
#   these, rgl fails, which cascades to break mixOmics, which cascades
#   to break DepecheR itself)
# pandoc: needed by rmarkdown, another DepecheR dependency that failed
#   in the same build
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    r-base \
    r-base-dev \
    build-essential \
    gfortran \
    libblas-dev \
    liblapack-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libfontconfig1-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    libgit2-dev \
    libuv1-dev \
    zlib1g-dev \
    libbz2-dev \
    liblzma-dev \
    libicu-dev \
    libpcre2-dev \
    libdeflate-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    libx11-dev \
    libxext-dev \
    libxt-dev \
    pandoc \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# Install FlowSOM and DepecheR via Bioconductor. This is the slow, large
# step -- compiling their combined dependency tree from source.
RUN Rscript -e ' \
    if (!require("BiocManager", quietly = TRUE)) install.packages("BiocManager", repos = "https://cloud.r-project.org"); \
    BiocManager::install(c("FlowSOM", "DepecheR"), update = FALSE, ask = FALSE)'

# Verify both actually loaded -- fails the build here (not silently at
# runtime) if something didn't install correctly.
RUN Rscript -e 'library(FlowSOM); library(DepecheR); cat("FlowSOM and DepecheR OK\n")'

COPY requirements.txt .

# See the default Dockerfile's comment on CACHEBUST -- same reasoning:
# requirements.txt's content doesn't change between conclave commits, so
# without this, Docker would cache a stale conclave install here too.
ARG CACHEBUST=1
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

ENV CONCLAVE_GUI_DATA=/data
VOLUME ["/data"]

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
